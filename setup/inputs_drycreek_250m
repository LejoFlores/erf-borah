# ERF, Dry Creek, 1 km -> 250 m only (no 50 m level): the default for runs after the Dec 2015 storm.
# Same as setup/inputs_drycreek without d03, ~15x cheaper. Level 0 = WPS d01 (123 x 123 cells at 1 km),
# level 1 = the WPS d02 footprint (wrfinput_d02 supplies its terrain and land); wrfinput_d03 is unused. run/erf_gpu.slurm sets the dates.
# ERF aborts on a key given twice: change values here or on the command line, not both.
start_datetime = "__START__"
stop_datetime  = "__END__"

# ---- Level 0 (= wrfinput_d01) ---------------------------------------------------------
geometry.prob_extent = 123000. 123000. 20000.   # z top is overwritten by the wrfinput heights
amr.n_cell           = 123 123 60               # 60 = e_vert - 1 in setup/namelist.input
geometry.is_periodic = 0 0 0
xlo.type = "Outflow"
xhi.type = "Outflow"
ylo.type = "Outflow"
yhi.type = "Outflow"
zlo.type = "surface_layer"
zhi.type = "SlipWall"
erf.most.average_policy = 1
erf.most.zref = 10.0                # YSU needs the surface layer at exactly 10 m (WRF's 10 m wind)
erf.most.use_interpolation = true   # without it, zref snaps to the first cell centre (~17 m here)

# ---- Nests as static refinement (one-way, like the SCHNAPS nests) -------------------
amr.max_level      = 1
amr.ref_ratio_vect = 4 4 1
amr.blocking_factor = 1      # the 123 x 123 x 60 domain (WRF d01) divides by no larger power of 2;
                              # 1 also keeps the nest exactly on the wrfinput_d02 footprint
amr.max_grid_size   = 128
erf.refinement_indicators = d02
erf.d02.in_box_lo = 50000. 46000. 0.        # 32 x 34 km at 250 m (SCHNAPS d02: 27.7 x 28.1 km)
erf.d02.in_box_hi = 82000. 80000. 20000.
erf.d02.max_level = 1
erf.coupling_type = "OneWay"

# ---- Initial and boundary data (run/wps_real.slurm) -------------------------------------
erf.init_type      = "WRFInput"
erf.nc_init_file_0 = "wrfinput_d01"
erf.nc_init_file_1 = "wrfinput_d02"
erf.nc_bdy_file    = "wrfbdy_d01"
erf.use_real_bcs   = true
erf.real_width     = 5
erf.use_wrf_bdy_density  = true
erf.use_wrf_bdy_qc_qi    = true          # HRRR cloud water and ice come in at the boundary;
erf.bdy_moist_nudge_type = 3             # rain, snow and graupel do not (ERF limitation)
erf.bdy_nudge_factor     = 10.0
erf.terrain_type      = StaticFittedMesh
erf.terrain_smoothing = 1
erf.amr_terrain_refinement = transform   # the nest keeps its own wrfinput_d02 terrain, blended into the
                                         # mesh interpolated from the parent (required with smoothing)

# ---- Time step ----------------------------------------------------------------------------
erf.fixed_dt     = 5.0                    # 1 km
erf.dt_ref_ratio = 4                      # 1.25 s at 250 m
erf.fixed_mri_dt_ratio = 6

# ---- Numerics (as ERF's WPS examples) ---------------------------------------------------
erf.dycore_horiz_adv_type  = Upwind_5th
erf.dycore_vert_adv_type   = Upwind_3rd
erf.dryscal_horiz_adv_type = WENO5
erf.dryscal_vert_adv_type  = WENO5
erf.moistscal_horiz_adv_type = WENO5
erf.moistscal_vert_adv_type  = WENO5
erf.implicit_before_substep     = true
erf.implicit_thermal_diffusion  = true
erf.implicit_moisture_diffusion = true
erf.implicit_momentum_diffusion = true
erf.vert_implicit_fac           = 1. 1. 0.

# ---- Physics: matched to SCHNAPS where ERF has the scheme ------------------------------
erf.moisture_model     = "Morrison"       # SCHNAPS: morrison
erf.land_surface_model = "NOAHMP"         # namelist.erf: phase from microphysics (PCP_PARTITION_OPTION 4)
erf.pbl_type = YSU YSU                    # SCHNAPS: YSU everywhere
erf.les_type = None None
erf.use_coriolis      = true
erf.variable_coriolis = true
erf.radiation_model        = "RRTMGP"
erf.rad_freq_in_steps      = 120          # level-0 steps: every 10 min
erf.rad_do_subcol_sampling = true
erf.rad_t_sfc              = 273.0        # required with RRTMGP (aborts if missing)
erf.co2vmr                 = 0.0004       # 2015: ~400 ppm
erf.o3vmr                  = 3.0e-8
erf.n2ovmr                 = 3.2e-7
erf.covmr                  = 1.5e-7
erf.ch4vmr                 = 1.8e-6
erf.o2vmr                  = 0.209
erf.n2vmr                  = 0.7906
erf.rrtmgp_file_path       = .
erf.rrtmgp_coeffs_sw       = rrtmgp-data-sw-g224-2018-12-04.nc
erf.rrtmgp_coeffs_lw       = rrtmgp-data-lw-g256-2018-12-04.nc
erf.rrtmgp_cloud_optics_sw = rrtmgp-cloud-optics-coeffs-sw.nc
erf.rrtmgp_cloud_optics_lw = rrtmgp-cloud-optics-coeffs-lw.nc
erf.rayleigh_damping_type = FastImplicit
erf.rayleigh_damp_W   = true
erf.rayleigh_zdamp    = 5000.0
erf.rayleigh_dampcoef = 0.2

# ---- Output -------------------------------------------------------------------------------
amr.v = 1
erf.v = 1
erf.plot_file_1 = plt
erf.plot_per_1  = 3600.                   # hourly, all levels
erf.plot_vars_1 = density x_velocity y_velocity z_velocity theta temp pres qv qc qi qrain qsnow qgraup rain_accum snow_accum graup_accum z_phys
                                          # Morrison: rain_accum is TOTAL precipitation (mm)
erf.check_file = chk
erf.check_per  = 21600.                   # restart files every 6 h
